--- /dev/null
+++ b/host/platform.h
@@ -0,0 +1,52 @@
+// What the host library needs of the system it runs on: on Windows WGL, as
+// QuarkTex was written for; elsewhere (Linux, Android) EGL.
+#ifndef QUARKTEX_PLATFORM_H
+#define QUARKTEX_PLATFORM_H
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#define QT_GET_PROC(name) wglGetProcAddress(name)
+#define QT_CURRENT_CONTEXT() wglGetCurrentContext()
+#else
+#include <EGL/egl.h>
+#if defined(__ANDROID__) && !defined(QT_GL4ES)
+// OpenGL ES 3 instead of desktop OpenGL: only ogles2.library's commands;
+// Warp3D, minigl and agl need OpenGL 1.1 and are left out (gles.cpp).
+#ifndef QT_GLES
+#define QT_GLES
+#endif
+#endif
+// QT_GL4ES: the second library on Android, libquarktexng_gl4es.so, for
+// minigl.library and agl.library: their OpenGL 1.1 through gl4es, which
+// draws with OpenGL ES 2. The OpenGL ES one hands their contexts to it.
+#ifndef APIENTRY
+#define APIENTRY
+#endif
+#ifndef WINAPI
+#define WINAPI
+#endif
+#ifndef __cdecl
+#define __cdecl
+#endif
+#if defined(QT_GL4ES)
+extern "C" void* gl4es_GetProcAddress(const char* name);
+#define QT_GET_PROC(name) gl4es_GetProcAddress(name)
+#elif defined(QT_GLES)
+// eglGetProcAddress need not know the core functions of OpenGL ES
+#include <dlfcn.h>
+inline void* qt_get_proc(const char* name) {
+	void* p = dlsym(RTLD_DEFAULT, name);
+	return p ? p : reinterpret_cast<void*>(eglGetProcAddress(name));
+}
+#define QT_GET_PROC(name) qt_get_proc(name)
+#else
+#define QT_GET_PROC(name) eglGetProcAddress(name)
+#endif
+#define QT_CURRENT_CONTEXT() eglGetCurrentContext()
+#if defined(QT_GLES) || defined(QT_GL4ES)
+#define QT_READ_RGBA // OpenGL ES has no GL_BGRA to read pictures back in
+#endif
+#endif
+
+#endif
