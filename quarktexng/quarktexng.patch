index 0000000..120292b
--- /dev/null
+++ b/host/gles.cpp
@@ -0,0 +1,29 @@
+// What the Android builds have in place of what they leave out. The OpenGL
+// ES one (QT_GLES) executes only ogles2.library's commands: Warp3D, minigl
+// and agl need OpenGL 1.1 (w3d.cpp, ffp.cpp, mgl.cpp and the decoder's
+// OpenGL commands are not built), their commands are refused as unknown
+// ones, and a context has no ffp state. The gl4es one (QT_GL4ES) has minigl
+// and agl, but not Warp3D, which needs OpenGL 3.3.
+#include "platform.h"
+#include <GL/gl.h>
+#include "gldecode.h"
+#include "ffp.h"
+
+bool qt_w3d_trace_textures = false;
