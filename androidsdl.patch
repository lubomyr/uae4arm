+
+package net.sourceforge.clonekeenplus;
+
+import android.content.Context;
+import android.media.midi.MidiDevice;
+import android.media.midi.MidiDeviceInfo;
+import android.media.midi.MidiInputPort;
+import android.media.midi.MidiManager;
+import android.media.midi.MidiOutputPort;
+import android.media.midi.MidiReceiver;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.SystemClock;
+import android.util.Log;
+import android.widget.Toast;
+import java.util.HashSet;
+import java.util.concurrent.ArrayBlockingQueue;
+
+// MIDI for the app through android.media.midi, Android 6 and later: a USB MIDI
+// device, or an app with a MIDI synthesizer. The app sends raw MIDI bytes to
+// the first device that takes them, and gets the bytes of the first device that
+// sends any. Devices plugged in later are picked up too.
+// Do not touch this class before Android 6, it does not load there.
+class Midi
+{
+	private static MidiManager manager = null;
+	private static HandlerThread thread = null;
+	private static Handler handler = null;
+	private static Context context = null;
+	private static int retries = 0;
+	// Devices asked to open and not answered yet: an app with a synthesizer may
+	// take its time to start, and the system turns away more asks meanwhile
+	private static final HashSet<Integer> opening = new HashSet<Integer>();
+
+	// The device the app sends to, and the device it receives from; can be the same one
+	private static MidiDevice outDevice = null, inDevice = null;
+	private static volatile MidiInputPort outPort = null;
+	private static MidiOutputPort inPort = null;
+	// For the app to show
+	private static volatile String outName = null, inName = null;
+
+	// The bytes go out on a thread of their own: writing to a device blocks while its process is
+	// frozen - MIUI freezes an app with a synthesizer after a while in the background - and the
+	// app's thread must not wait for that. A write that hangs gets the device opened again,
+	// which wakes the process up, as switching MIDI off and on does.
+	private static final ArrayBlockingQueue<byte[]> outQueue = new ArrayBlockingQueue<byte[]>(4096);
+	private static Thread outThread = null;
+	private static volatile long sendingSince = 0;
+	private static final long SEND_STUCK_MS = 1500;
+	// MIUI pauses the sound of an app that has played only silence for a minute, and an app with
+	// a synthesizer then takes the notes and plays nothing. Opening its port again starts its
+	// sound anew, as such an app plays while a port is open: done before the first bytes after
+	// a quiet while. Not the whole device: FluidSynth MIDI may crash when its service goes.
+	private static volatile long lastSent = 0;
+	private static final long QUIET_REOPEN_MS = 30000;
+	// A synthesizer that went away, crashed, fails the writes: open it again, not too often
+	private static long lastRecovery = 0;
+	private static final long RECOVERY_MS = 2000;
+	// What the channels were set to, for a synthesizer that starts anew: a player sets the
+	// instruments, volumes and so on once, at the start of a song. -1 for not set.
+	private static final int[] channelProgram = new int[16];
+	private static final int[][] channelControl = new int[16][120]; // not the channel mode messages
+	private static final int[] channelBend = new int[16];
+	// Set when the port or the device was opened again
+	private static volatile boolean replayNeeded = false;
+
+	private static void forgetChannels()
+	{
+		for (int ch = 0; ch < 16; ch++)
+		{
+			channelProgram[ch] = -1;
+			channelBend[ch] = -1;
+			for (int c = 0; c < 120; c++)
+				channelControl[ch][c] = -1;
+		}
+	}
+
+	private static void noteChannels(byte[] m)
+	{
+		if (m.length < 2 || (m[0] & 0x80) == 0)
+			return;
+		int status = m[0] & 0xf0, ch = m[0] & 0x0f;
+		if (status == 0xc0)
+			channelProgram[ch] = m[1] & 0x7f;
+		else if (status == 0xb0 && m.length >= 3 && (m[1] & 0x7f) < 120)
+			channelControl[ch][m[1] & 0x7f] = m[2] & 0x7f;
+		else if (status == 0xb0 && m.length >= 3 && (m[1] & 0x7f) == 121) // reset all controllers
+		{
+			for (int c = 0; c < 120; c++)
+				channelControl[ch][c] = -1;
+			channelBend[ch] = -1;
+		}
+		else if (status == 0xe0 && m.length >= 3)
+			channelBend[ch] = (m[1] & 0x7f) | ((m[2] & 0x7f) << 7);
+	}
+
+	// Sets a new synthesizer up as the old one was: bank, instrument, controllers, pitch bend
+	private static void replayChannels(MidiInputPort port)
+	{
+		try
+		{
+			for (int ch = 0; ch < 16; ch++)
+			{
+				for (int c: new int[] { 0, 32 })
+					if (channelControl[ch][c] >= 0)
+						port.send(new byte[] { (byte)(0xb0 | ch), (byte)c, (byte)channelControl[ch][c] }, 0, 3);
+				if (channelProgram[ch] >= 0)
+					port.send(new byte[] { (byte)(0xc0 | ch), (byte)channelProgram[ch] }, 0, 2);
+				for (int c = 1; c < 120; c++)
+					if (c != 32 && channelControl[ch][c] >= 0)
+						port.send(new byte[] { (byte)(0xb0 | ch), (byte)c, (byte)channelControl[ch][c] }, 0, 3);
+				if (channelBend[ch] >= 0)
+					port.send(new byte[] { (byte)(0xe0 | ch), (byte)(channelBend[ch] & 0x7f), (byte)(channelBend[ch] >> 7) }, 0, 3);
+			}
+		}
+		catch (Exception e)
+		{
+		}
+	}
+
+	private static final MidiReceiver receiver = new MidiReceiver()
+	{
+		@Override
+		public void onSend(byte[] data, int offset, int count, long timestamp)
+		{
+			DemoRenderer.nativeMidiReceived(data, offset, count);
+		}
+	};
+
+	private static final MidiManager.DeviceCallback deviceCallback = new MidiManager.DeviceCallback()
+	{
+		@Override
+		public void onDeviceAdded(MidiDeviceInfo info)
+		{
+			retries = 0;
+			openDevice(info);
+		}
+
+		@Override
+		public void onDeviceRemoved(MidiDeviceInfo info)
+		{
+			boolean lost = false;
+			if (outDevice != null && outDevice.getInfo().getId() == info.getId())
+			{
+				closeOut();
+				lost = true;
+			}
+			if (inDevice != null && inDevice.getInfo().getId() == info.getId())
+			{
+				closeIn();
+				lost = true;
+			}
+			if (lost)
+				openAllDevices(); // another one may be there
+		}
+	};
+
+	static synchronized boolean open(Context ctx)
+	{
+		if (manager != null)
+			return true;
+		try
+		{
+			context = ctx;
+			retries = 0;
+			manager = (MidiManager) ctx.getSystemService(Context.MIDI_SERVICE);
+			if (manager == null)
+			{
+				Log.i("SDL", "MIDI: the system has no MIDI support");
+				return false;
+			}
+			thread = new HandlerThread("MIDI");
+			thread.start();
+			handler = new Handler(thread.getLooper());
+			manager.registerDeviceCallback(deviceCallback, handler);
+			handler.post(new Runnable() { public void run() { openAllDevices(); } });
+			outQueue.clear();
+			lastSent = 0;
+			forgetChannels();
+			outThread = new Thread(new Runnable() { public void run() { sendLoop(); } }, "MIDI out");
+			outThread.setDaemon(true); // a write stuck in a frozen device does not hold the app
+			outThread.start();
+			handler.postDelayed(watchdog, 1000);
+			return true;
+		}
+		catch (Exception e)
+		{
+			Log.i("SDL", "MIDI: cannot open: " + e);
+			manager = null;
+			return false;
+		}
+	}
+
+	static synchronized void close()
+	{
+		if (manager == null)
+			return;
+		try
+		{
+			manager.unregisterDeviceCallback(deviceCallback);
+		}
+		catch (Exception e)
+		{
+		}
+		final HandlerThread t = thread;
+		handler.removeCallbacks(watchdog);
+		if (outThread != null)
+			outThread.interrupt();
+		outThread = null;
+		outQueue.clear();
+		handler.post(new Runnable()
+		{
+			public void run()
+			{
+				closeOut();
+				closeIn();
+				opening.clear();
+				t.quitSafely();
+			}
+		});
+		manager = null;
+		handler = null;
+		thread = null;
+	}
+
+	static void send(byte[] data, int count)
+	{
+		if (outPort == null)
+			return;
+		byte[] copy = new byte[count];
+		System.arraycopy(data, 0, copy, 0, count);
+		outQueue.offer(copy); // dropped when the device has not taken the bytes for long
+	}
+
+	private static void sendLoop()
+	{
+		while (!Thread.currentThread().isInterrupted())
+		{
+			byte[] bytes;
+			try
+			{
+				bytes = outQueue.take();
+			}
+			catch (InterruptedException e)
+			{
+				return;
+			}
+			MidiDevice device = outDevice;
+			if (lastSent != 0 && SystemClock.uptimeMillis() - lastSent > QUIET_REOPEN_MS &&
+				device != null && device.getInfo().getType() == MidiDeviceInfo.TYPE_VIRTUAL)
+			{
+				Log.i("SDL", "MIDI: " + outName + " was quiet for a while, opening its port again");
+				if (!reopenAndWait(true))
+					return;
+			}
+			MidiInputPort port = outPort;
+			if (port == null)
+				continue;
+			if (replayNeeded)
+			{
+				replayNeeded = false;
+				replayChannels(port);
+			}
+			noteChannels(bytes);
+			sendingSince = SystemClock.uptimeMillis();
+			boolean failed = false;
+			try
+			{
+				port.send(bytes, 0, bytes.length);
+			}
+			catch (Exception e)
+			{
+				failed = true;
+			}
+			sendingSince = 0;
+			lastSent = SystemClock.uptimeMillis();
+			if (failed && port == outPort && lastSent - lastRecovery > RECOVERY_MS)
+			{
+				lastRecovery = lastSent;
+				Log.i("SDL", "MIDI: " + outName + " does not take the bytes anymore, opening it again");
+				if (!reopenAndWait(false))
+					return;
+
+			}
+		}
+	}
+
+	// Opens the port again on the MIDI thread - or with portOnly false, or if that fails, the
+	// devices - and waits for the new port; false when the sending thread is to stop
+	private static boolean reopenAndWait(final boolean portOnly)
+	{
+		Handler h = handler;
+		if (h == null)
+			return true;
+		final MidiInputPort old = outPort;
+		h.post(new Runnable()
+		{
+			public void run()
+			{
+				MidiDevice device = outDevice;
+				if (portOnly && device != null && old != null)
+				{
+					outPort = null;
+					try
+					{
+						old.close();
+					}
+					catch (Exception e)
+					{
+					}
+					MidiInputPort port = null;
+					try
+					{
+						port = device.openInputPort(0);
+					}
+					catch (Exception e)
+					{
+					}
+					if (port != null)
+					{
+						replayNeeded = true;
+						outPort = port;
+						return;
+					}
+				}
+				replayNeeded = true;
+				closeOut();
+				closeIn();
+				openAllDevices();
+			}
+		});
+		long until = SystemClock.uptimeMillis() + 3000;
+		while (SystemClock.uptimeMillis() < until && (outPort == null || outPort == old))
+		{
+			try
+			{
+				Thread.sleep(20);
+			}
+			catch (InterruptedException e)
+			{
+				return false;
+			}
+		}
+		return true;
+	}
+
+	private static final Runnable watchdog = new Runnable()
+	{
+		public void run()
+		{
+			long since = sendingSince;
+			if (since != 0 && SystemClock.uptimeMillis() - since > SEND_STUCK_MS && outDevice != null)
+			{
+				Log.i("SDL", "MIDI: " + outName + " does not take the bytes, opening it again");
+				sendingSince = 0;
+				replayNeeded = true;
+				closeOut();
+				openAllDevices();
+			}
+			if (handler != null)
+				handler.postDelayed(this, 1000);
+		}
+	};
+
+	@SuppressWarnings("deprecation")
+	private static void openAllDevices()
+	{
+		if (manager == null)
+			return;
+		MidiDeviceInfo[] devices;
+		try
+		{
+			devices = manager.getDevices();
+		}
+		catch (Exception e)
+		{
+			return;
+		}
+		// A USB or Bluetooth device first: it is what someone plugs in for this
+		for (int pass = 0; pass < 2; pass++)
+			for (MidiDeviceInfo info: devices)
+				if ((info.getType() != MidiDeviceInfo.TYPE_VIRTUAL) == (pass == 0))
+					openDevice(info);
+	}
+
+	private static void openDevice(final MidiDeviceInfo info)
+	{
+		if (manager == null)
+			return;
+		final boolean takesBytes = outDevice == null && info.getInputPortCount() > 0;
+		final boolean sendsBytes = inDevice == null && info.getOutputPortCount() > 0;
+		if (!takesBytes && !sendsBytes)
+			return;
+		if (info.getType() == MidiDeviceInfo.TYPE_BLUETOOTH)
+			return; // these have to be paired with openBluetoothDevice(), not done yet
+		if (!opening.add(info.getId()))
+			return;
+		try
+		{
+			manager.openDevice(info, new MidiManager.OnDeviceOpenedListener()
+			{
+				public void onDeviceOpened(MidiDevice device)
+				{
+					opening.remove(info.getId());
+					try
+					{
+						deviceOpened(info, device, takesBytes, sendsBytes);
+					}
+					catch (Exception e)
+					{
+						Log.i("SDL", "MIDI: cannot use " + deviceName(info) + ": " + e);
+						retryLater();
+					}
+				}
+			}, handler);
+		}
+		catch (Exception e)
+		{
+			// A device that is being installed or removed comes and goes: an app
+			// with a synthesizer is told of while it is still being installed
+			Log.i("SDL", "MIDI: cannot open " + deviceName(info) + ": " + e);
+			opening.remove(info.getId());
+			retryLater();
+		}
+	}
+
+	// A few times, then it waits for the next device to come
+	private static void retryLater()
+	{
+		if (handler == null || ++retries > 5)
+			return;
+		handler.postDelayed(new Runnable() { public void run() { openAllDevices(); } }, 1000);
+	}
+
+	private static void deviceOpened(MidiDeviceInfo info, MidiDevice device, boolean takesBytes, boolean sendsBytes)
+	{
+		if (device == null)
+		{
+			Log.i("SDL", "MIDI: cannot open " + deviceName(info));
+			retryLater();
+			return;
+		}
+		boolean used = false;
+		if (manager != null && takesBytes && outDevice == null)
+		{
+			MidiInputPort port = device.openInputPort(0);
+			if (port != null)
+			{
+				outDevice = device;
+				outPort = port;
+				outName = deviceName(info);
+				lastSent = SystemClock.uptimeMillis(); // quiet since it was opened
+				used = true;
+				Log.i("SDL", "MIDI: sending to " + outName);
+			}
+		}
+		if (manager != null && sendsBytes && inDevice == null)
+		{
+			MidiOutputPort port = device.openOutputPort(0);
+			if (port != null)
+			{
+				port.connect(receiver);
+				inDevice = device;
+				inPort = port;
+				inName = deviceName(info);
+				used = true;
+				Log.i("SDL", "MIDI: receiving from " + inName);
+			}
+		}
+		if (used)
+			showToast("MIDI: " + deviceName(info));
+		else
+		{
+			try
+			{
+				device.close();
+			}
+			catch (Exception e)
+			{
+			}
+		}
+	}
+
+	static String deviceName(boolean input)
+	{
+		return input ? inName : outName;
+	}
+
+	private static void closeOut()
+	{
+		MidiInputPort port = outPort;
+		outPort = null;
+		outName = null;
+		try
+		{
+			if (port != null)
+				port.close();
+			if (outDevice != null && outDevice != inDevice)
+				outDevice.close();
+		}
+		catch (Exception e)
+		{
+		}
+		outDevice = null;
+	}
+
+	private static void closeIn()
+	{
+		try
+		{
+			if (inPort != null)
+			{
+				inPort.disconnect(receiver);
+				inPort.close();
+			}
+			if (inDevice != null && inDevice != outDevice)
+				inDevice.close();
+		}
+		catch (Exception e)
+		{
+		}
+		inPort = null;
+		inDevice = null;
+		inName = null;
+	}
+
+	private static String deviceName(MidiDeviceInfo info)
+	{
+		Bundle p = info.getProperties();
+		String name = p.getString(MidiDeviceInfo.PROPERTY_NAME);
+		if (name == null)
+			name = p.getString(MidiDeviceInfo.PROPERTY_PRODUCT);
+		return name != null ? name : "MIDI device " + info.getId();
+	}
+
+	private static void showToast(final String text)
+	{
+		final Context ctx = context;
+		if (ctx instanceof MainActivity)
+			((MainActivity) ctx).runOnUiThread(new Runnable()
+			{
+				public void run()
+				{
+					Toast.makeText(ctx, text, Toast.LENGTH_SHORT).show();
+				}
+			});
+	}
+}
