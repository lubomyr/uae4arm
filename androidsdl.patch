+static pthread_once_t midiDetachKeyOnce = PTHREAD_ONCE_INIT;
+
+static void MidiDetachThread(void *unused)
+{
+	JavaVM *vm = SDL_ANDROID_JavaVM();
+	(*vm)->DetachCurrentThread(vm);
+}
+
+static void MidiCreateDetachKey(void)
+{
+	pthread_key_create(&midiDetachKey, MidiDetachThread);
+}
+
+static JNIEnv *GetJavaEnvAttached(void)
+{
+	JavaVM *vm = SDL_ANDROID_JavaVM();
+	JNIEnv *ret = NULL;
+	if( (*vm)->GetEnv(vm, (void **) &ret, JNI_VERSION_1_6) != JNI_OK )
+	{
+		// Java aborts the app if a thread it knows ends without telling it
+		ret = NULL;
+		if( (*vm)->AttachCurrentThread(vm, &ret, NULL) != JNI_OK )
+			return NULL;
+		pthread_once(&midiDetachKeyOnce, MidiCreateDetachKey);
+		pthread_setspecific(midiDetachKey, (void *) 1);
+	}
+	return ret;
+}
+
+int SDLCALL SDL_ANDROID_MidiOpen(void)
+{
+	JNIEnv *JavaEnv = GetJavaEnvAttached();
+	if( !JavaEnv || !JavaRenderer )
+		return 0;
+	if( !midiSendArray )
+	{
+		jbyteArray a = (*JavaEnv)->NewByteArray(JavaEnv, MIDI_SEND_ARRAY_SIZE);
+		midiSendArray = (jbyteArray) (*JavaEnv)->NewGlobalRef(JavaEnv, a);
+		(*JavaEnv)->DeleteLocalRef(JavaEnv, a);
+	}
+	__atomic_store_n(&midiInRead, __atomic_load_n(&midiInWrite, __ATOMIC_ACQUIRE), __ATOMIC_RELEASE);
+	return (*JavaEnv)->CallIntMethod( JavaEnv, JavaRenderer, JavaMidiOpen );
+}
+
+void SDLCALL SDL_ANDROID_MidiClose(void)
+{
+	JNIEnv *JavaEnv = GetJavaEnvAttached();
+	if( !JavaEnv || !JavaRenderer )
+		return;
+	(*JavaEnv)->CallVoidMethod( JavaEnv, JavaRenderer, JavaMidiClose );
+}
+
+void SDLCALL SDL_ANDROID_MidiSend(const unsigned char *data, int len)
+{
+	JNIEnv *JavaEnv = GetJavaEnvAttached();
+	if( !JavaEnv || !JavaRenderer || !midiSendArray )
+		return;
+	while( len > 0 )
+	{
+		int n = len < MIDI_SEND_ARRAY_SIZE ? len : MIDI_SEND_ARRAY_SIZE;
+		(*JavaEnv)->SetByteArrayRegion(JavaEnv, midiSendArray, 0, n, (const jbyte *) data);
+		(*JavaEnv)->CallVoidMethod( JavaEnv, JavaRenderer, JavaMidiSend, midiSendArray, (jint) n );
+		data += n;
+		len -= n;
+	}
+}
+
+void SDLCALL SDL_ANDROID_MidiDeviceName(int input, char *name, int size)
+{
+	JNIEnv *JavaEnv = GetJavaEnvAttached();
+	jstring s;
+	if( size <= 0 )
+		return;
+	name[0] = 0;
+	if( !JavaEnv || !JavaRenderer )
+		return;
+	(*JavaEnv)->PushLocalFrame(JavaEnv, 1);
+	s = (jstring) (*JavaEnv)->CallObjectMethod( JavaEnv, JavaRenderer, JavaMidiDeviceName, (jint) input );
+	if( s )
+	{
+		const char *c = (*JavaEnv)->GetStringUTFChars(JavaEnv, s, NULL);
+		if( c )
+		{
+			strncpy(name, c, size - 1);
+			name[size - 1] = 0;
+			(*JavaEnv)->ReleaseStringUTFChars(JavaEnv, s, c);
+		}
+	}
+	(*JavaEnv)->PopLocalFrame(JavaEnv, NULL);
+}
+
+int SDLCALL SDL_ANDROID_MidiReceive(unsigned char *data, int len)
+{
+	unsigned int r = midiInRead;
+	unsigned int w = __atomic_load_n(&midiInWrite, __ATOMIC_ACQUIRE);
+	int n = 0;
+	while( n < len && r != w )
+	{
+		data[n++] = midiInBuf[r];
+		r = (r + 1) % sizeof(midiInBuf);
+	}
+	__atomic_store_n(&midiInRead, r, __ATOMIC_RELEASE);
+	return n;
+}
+
+JNIEXPORT void JNICALL
+JAVA_EXPORT_NAME(DemoRenderer_nativeMidiReceived) ( JNIEnv*  env, jobject thiz, jbyteArray data, jint offset, jint count )
+{
+	jbyte bytes[256];
+	while( count > 0 )
+	{
+		int n = count < (jint) sizeof(bytes) ? count : (jint) sizeof(bytes), i;
+		unsigned int w = midiInWrite;
+		unsigned int r = __atomic_load_n(&midiInRead, __ATOMIC_ACQUIRE);
+		(*env)->GetByteArrayRegion(env, data, offset, n, bytes);
+		for( i = 0; i < n; i++ )
+		{
+			unsigned int next = (w + 1) % sizeof(midiInBuf);
+			if( next == r )
+				break; // full: the app is not reading, drop the rest
+			midiInBuf[w] = (unsigned char) bytes[i];
+			w = next;
+		}
+		__atomic_store_n(&midiInWrite, w, __ATOMIC_RELEASE);
+		offset += n;
+		count -= n;
+	}
+}
