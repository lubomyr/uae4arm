@@ -940,6 +940,42 @@ public class Settings
 
 	static final int SDL_ANDROID_CONFIG_VIDEO_DEPTH_BPP = 0;
 	static final int SDL_ANDROID_CONFIG_VIDEO_ORIENTATION_PORTRAIT = 1;
+	static final int SDL_ANDROID_CONFIG_SCREENKB_THEME = 2;
+	static final int SDL_ANDROID_CONFIG_SCREENKB_SIZE = 3;
+	static final int SDL_ANDROID_CONFIG_SCREENKB_DRAWSIZE = 4;
+	static final int SDL_ANDROID_CONFIG_SCREENKB_TRANSPARENCY = 5;
+	static final int SDL_ANDROID_CONFIG_KEEP_ASPECT_RATIO = 6;
+
+	// Re-applies the on-screen control settings to the running app. The settings menu
+	// only ever applies them at startup, but an app that offers them in its own UI
+	// needs them to take effect right away.
+	private static void applyScreenKeyboardSettings(boolean reloadGraphics)
+	{
+		if( !Globals.UseTouchscreenKeyboard )
+			return;
+		nativeSetupScreenKeyboard(	Globals.TouchscreenKeyboardSize,
+									Globals.TouchscreenKeyboardDrawSize,
+									Globals.TouchscreenKeyboardTheme,
+									Globals.TouchscreenKeyboardTransparency,
+									Globals.FloatingScreenJoystick ? 1 : 0,
+									Globals.AppTouchscreenKeyboardKeysAmount );
+		// Only the theme changes the button bitmaps, and reloading them means
+		// re-uploading every texture, so do not do it for the other options.
+		if( reloadGraphics )
+			DemoGLSurfaceView.SetupTouchscreenKeyboardGraphics(MainActivity.instance);
+		// nativeSetupScreenKeyboard() lays out every button from scratch, and a hidden
+		// button is just one with an empty rect - so without this the call above brings
+		// back each button the user has switched off. Apply() does the same afterwards.
+		if( Globals.TouchscreenKeyboardSize == Globals.TOUCHSCREEN_KEYBOARD_CUSTOM )
+		{
+			for( int i = 0; i < Globals.ScreenKbControlsLayout.length; i++ )
+				if( Globals.ScreenKbControlsLayout[i][0] < Globals.ScreenKbControlsLayout[i][2] )
+					nativeSetScreenKbKeyLayout( i, Globals.ScreenKbControlsLayout[i][0], Globals.ScreenKbControlsLayout[i][1],
+						Globals.ScreenKbControlsLayout[i][2], Globals.ScreenKbControlsLayout[i][3]);
+		}
+		for( int i = 0; i < Globals.ScreenKbControlsShown.length; i++ )
+			nativeSetScreenKbKeyUsed(i, Globals.ScreenKbControlsShown[i] ? 1 : 0);
+	}
 
 	public static void setConfigOptionFromSDL(int option, int value)
 	{
@@ -951,6 +987,29 @@ public class Settings
 			case SDL_ANDROID_CONFIG_VIDEO_ORIENTATION_PORTRAIT:
 				Globals.HorizontalOrientation = (value == 0);
 				break;
+			case SDL_ANDROID_CONFIG_SCREENKB_THEME:
+				Globals.TouchscreenKeyboardTheme = value;
+				applyScreenKeyboardSettings(true);
+				break;
+			case SDL_ANDROID_CONFIG_SCREENKB_SIZE:
+				Globals.TouchscreenKeyboardSize = value;
+				applyScreenKeyboardSettings(false);
+				break;
+			case SDL_ANDROID_CONFIG_SCREENKB_DRAWSIZE:
+				Globals.TouchscreenKeyboardDrawSize = value;
+				applyScreenKeyboardSettings(false);
+				break;
+			case SDL_ANDROID_CONFIG_SCREENKB_TRANSPARENCY:
+				Globals.TouchscreenKeyboardTransparency = value;
+				applyScreenKeyboardSettings(false);
+				break;
+			case SDL_ANDROID_CONFIG_KEEP_ASPECT_RATIO:
+				if( MainActivity.instance != null && MainActivity.instance.mGLView != null &&
+					MainActivity.instance.mGLView.mRenderer != null )
+					MainActivity.instance.mGLView.mRenderer.setKeepAspectRatio(value);
+				else
+					Globals.KeepAspectRatio = (value != 0);
+				break;
 			default:
 				Log.e("SDL", "setConfigOptionFromSDL: cannot find option with ID " + option + ", value " + value);
 				break;
