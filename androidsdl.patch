+			nativeSetScreenKbKeyUsed(i, Globals.ScreenKbControlsShown[i] ? 1 : 0);
+	}
+
+	// The separate video thread crashes on some devices, so an app that turns
+	// it on gets it on trial: a file says so until the app confirms it started
+	// fine. A start that finds the trial already begun means the one before
+	// never got that far, and turns the thread off again.
+	static final String VIDEO_THREAD_TRIAL_FILE = "video-thread-trial";
+	static final String VIDEO_THREAD_TRIAL_PENDING = "pending";
+	static final String VIDEO_THREAD_TRIAL_STARTED = "started";
+
+	static void setVideoThreadTrial(MainActivity p, String state)
+	{
+		File f = new File(p.getFilesDir(), VIDEO_THREAD_TRIAL_FILE);
+		if( state == null )
+		{
+			f.delete();
+			return;
+		}
+		try
+		{
+			FileOutputStream out = new FileOutputStream(f);
+			out.write(state.getBytes());
+			out.close();
+		}
+		catch( IOException e )
+		{
+			Log.e("SDL", "Cannot write " + f + ": " + e);
+		}
+	}
+
+	static void checkVideoThreadTrial(final MainActivity p)
+	{
+		File f = new File(p.getFilesDir(), VIDEO_THREAD_TRIAL_FILE);
+		if( !f.exists() )
+			return;
+		String state = "";
+		try
+		{
+			BufferedReader in = new BufferedReader(new FileReader(f));
+			String line = in.readLine();
+			in.close();
+			if( line != null )
+				state = line.trim();
+		}
+		catch( IOException e )
+		{
+		}
+		if( state.equals(VIDEO_THREAD_TRIAL_PENDING) )
+		{
+			Log.i("SDL", "Trying out the separate video thread");
+			setVideoThreadTrial(p, VIDEO_THREAD_TRIAL_STARTED);
+			return;
+		}
+		Log.i("SDL", "The last start with the separate video thread did not get through, turning it off");
+		Globals.MultiThreadedVideo = false;
+		setVideoThreadTrial(p, null);
+		Save(p);
+		p.runOnUiThread(new Runnable()
+		{
+			public void run()
+			{
+				Toast.makeText(p, "Separate thread for video was turned off: the app did not start with it", Toast.LENGTH_LONG).show();
+			}
+		});
+	}
+
