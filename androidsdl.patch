+
+package net.sourceforge.clonekeenplus;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.SurfaceTexture;
+import android.media.MediaPlayer;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.Surface;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+import java.io.File;
+
+// A window that plays a video over the app, with the decoder of the system: the app asks for it
+// with a file of its own, the window can be moved, resized, made full screen and closed, and the
+// app goes on underneath. Made and used on the UI thread only.
+class VideoWindow
+{
+	private final MainActivity context;
+	private final FrameLayout parent;
+	private final float dp;
+
+	private LinearLayout window = null;
+	private TextureView video;
+	private TextView title, playButton, time;
+	private SeekBar seek;
+	private MediaPlayer player = null;
+	private boolean prepared = false; // asking the player anything before is an error
+	private boolean seeking = false; // the position bar is held
+	private Surface surface = null;
+	private String path = null;
+	private int videoWidth = 16, videoHeight = 9;
+	private int width; // of the window, the height follows the video
+	private boolean fullScreen = false;
+	private boolean hidden = false, playingWhenHidden = false;
+	private float savedX, savedY;
+	private int savedWidth;
+	private final Handler handler = new Handler(Looper.getMainLooper());
+
+	VideoWindow(MainActivity context, FrameLayout parent)
+	{
+		this.context = context;
+		this.parent = parent;
+		this.dp = context.getResources().getDisplayMetrics().density;
+	}
+
+	// Hides the window, paused, while the app shows something else, such as its menu; showing it
+	// again goes on playing if it played
+	void setHidden(boolean hide)
+	{
+		if (hide == hidden)
+			return;
+		hidden = hide;
+		if (window == null)
+			return;
+		if (hide)
+		{
+			playingWhenHidden = false;
+			try
+			{
+				playingWhenHidden = player != null && prepared && player.isPlaying();
+			}
+			catch (Exception e)
+			{
+			}
+			pause();
+			window.setVisibility(View.GONE);
+		}
+		else
+		{
+			window.setVisibility(View.VISIBLE);
+			if (playingWhenHidden && player != null && prepared)
+			{
+				player.start();
+				updateButtons();
+			}
+		}
+	}
+
+	void play(String path)
+	{
+		hidden = false;
+		if (window == null)
+			create();
+		window.setVisibility(View.VISIBLE);
+		this.path = path;
+		title.setText(new File(path).getName());
+		if (surface != null)
+			open();
+	}
+
+	void pause()
+	{
+		if (player != null && prepared && player.isPlaying())
+		{
+			player.pause();
+			updateButtons();
+		}
+	}
+
+	void close()
+	{
+		handler.removeCallbacks(progress);
+		releasePlayer();
+		if (window != null)
+			parent.removeView(window);
+		window = null;
+		surface = null;
+	}
+
+	private int px(float v)
+	{
+		return (int)(v * dp + 0.5f);
+	}
+
+	// Icons drawn to a size, not characters of the font: those come out in all sizes
+	private static final int ICON_RESIZE = 0, ICON_FULLSCREEN = 1;
+
+	private View icon(final int kind, View.OnClickListener click)
+	{
+		View v = new View(context)
+		{
+			final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+			@Override
+			protected void onDraw(Canvas c)
+			{
+				float w = getWidth(), h = getHeight(), cx = w / 2, cy = h / 2;
+				paint.setStrokeWidth(px(2.5f));
+				paint.setStrokeCap(Paint.Cap.ROUND);
+				if (kind == ICON_RESIZE)
+				{
+					// Three strokes in the corner, the grip of desktop windows
+					paint.setColor(Color.LTGRAY);
+					float m = px(6);
+					for (int i = 0; i < 3; i++)
+					{
+						float d = m + i * px(8.5f);
+						c.drawLine(w - m, h - d, w - d, h - m, paint);
+					}
+				}
+				else
+				{
+					// The four corners of a frame
+					paint.setColor(Color.WHITE);
+					float r = px(7), l = px(4);
+					float[][] corners = { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } };
+					for (float[] k: corners)
+					{
+						float x = cx + k[0] * r, y = cy + k[1] * r;
+						c.drawLine(x, y, x - k[0] * l, y, paint);
+						c.drawLine(x, y, x, y - k[1] * l, paint);
+					}
+				}
+			}
+		};
+		if (click != null)
+			v.setOnClickListener(click);
+		v.setFocusable(false);
+		return v;
+	}
+
+	private TextView button(String label, View.OnClickListener click)
+	{
+		TextView b = new TextView(context);
+		b.setText(label);
+		b.setTextColor(Color.WHITE);
+		b.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20);
+		b.setGravity(Gravity.CENTER);
+		b.setMinWidth(px(44));
+		b.setOnClickListener(click);
+		b.setFocusable(false);
+		return b;
+	}
+
+	private void create()
+	{
+		width = Math.max(px(240), parent.getWidth() * 2 / 5);
+
+		window = new LinearLayout(context);
+		window.setOrientation(LinearLayout.VERTICAL);
+		window.setBackgroundColor(Color.BLACK);
+		window.setFocusable(false);
+		if (android.os.Build.VERSION.SDK_INT >= 21)
+			window.setElevation(px(8));
+
+		// Title bar: drag it to move the window
+		LinearLayout bar = new LinearLayout(context);
+		bar.setOrientation(LinearLayout.HORIZONTAL);
+		bar.setBackgroundColor(Color.rgb(0x2a, 0x5d, 0x9f));
+		bar.setGravity(Gravity.CENTER_VERTICAL);
+		title = new TextView(context);
+		title.setTextColor(Color.WHITE);
+		title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+		title.setSingleLine(true);
+		title.setPadding(px(10), 0, px(4), 0);
+		bar.addView(title, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+		playButton = button("⏸", new View.OnClickListener() { public void onClick(View v) { togglePlay(); } });
+		// A fixed size, as for the time below: ▶ and ⏸ differ in width, and a layout moved the app's mouse
+		bar.addView(playButton, new LinearLayout.LayoutParams(px(44), px(40)));
+		bar.addView(icon(ICON_FULLSCREEN, new View.OnClickListener() { public void onClick(View v) { toggleFullScreen(); } }),
+			new LinearLayout.LayoutParams(px(44), px(40)));
+		bar.addView(button("✕", new View.OnClickListener() { public void onClick(View v) { close(); } }),
+			new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, px(40)));
+		bar.setOnTouchListener(new View.OnTouchListener()
+		{
+			float downX, downY, startX, startY;
+			public boolean onTouch(View v, MotionEvent e)
+			{
+				if (fullScreen)
+					return true;
+				if (e.getActionMasked() == MotionEvent.ACTION_DOWN)
+				{
+					downX = e.getRawX();
+					downY = e.getRawY();
+					startX = left();
+					startY = top();
+				}
+				else if (e.getActionMasked() == MotionEvent.ACTION_MOVE)
+					moveTo(startX + e.getRawX() - downX, startY + e.getRawY() - downY);
+				return true;
+			}
+		});
+		window.addView(bar, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, px(40)));
+
+		// The picture; a tap pauses and goes on
+		video = new TextureView(context);
+		video.setSurfaceTextureListener(new TextureView.SurfaceTextureListener()
+		{
+			public void onSurfaceTextureAvailable(SurfaceTexture st, int w, int h)
+			{
+				surface = new Surface(st);
+				if (path != null)
+					open();
+			}
+			public void onSurfaceTextureSizeChanged(SurfaceTexture st, int w, int h) { }
+			public boolean onSurfaceTextureDestroyed(SurfaceTexture st)
+			{
+				releasePlayer();
+				surface = null;
+				return true;
+			}
+			public void onSurfaceTextureUpdated(SurfaceTexture st) { }
+		});
+		video.setOnClickListener(new View.OnClickListener() { public void onClick(View v) { togglePlay(); } });
+		window.addView(video, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));
+
+		// Position, time, and a corner to drag for the size
+		LinearLayout bottom = new LinearLayout(context);
+		bottom.setOrientation(LinearLayout.HORIZONTAL);
+		bottom.setGravity(Gravity.CENTER_VERTICAL);
+		bottom.setBackgroundColor(Color.rgb(0x20, 0x20, 0x20));
+		seek = new SeekBar(context);
+		seek.setFocusable(false);
+		seek.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener()
+		{
+			public void onProgressChanged(SeekBar s, int value, boolean fromUser)
+			{
+				if (fromUser && player != null && prepared)
+					time.setText(clock(value) + " / " + clock(s.getMax()));
+			}
+			public void onStartTrackingTouch(SeekBar s)
+			{
+				seeking = true;
+			}
+			public void onStopTrackingTouch(SeekBar s)
+			{
+				seeking = false;
+				seekTo(s.getProgress());
+			}
+		});
+		bottom.addView(seek, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+		time = new TextView(context);
+		time.setTextColor(Color.WHITE);
+		time.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+		time.setPadding(px(4), 0, px(4), 0);
+		// A fixed size, so that the text changing twice a second does not lay the views out again:
+		// after each layout the system sends the mouse position again, which moved the app's mouse
+		time.setGravity(Gravity.CENTER);
+		time.setSingleLine(true);
+		bottom.addView(time, new LinearLayout.LayoutParams(px(96), px(40)));
+		View corner = icon(ICON_RESIZE, null);
+		corner.setOnTouchListener(new View.OnTouchListener()
+		{
+			float downX; int startWidth;
+			public boolean onTouch(View v, MotionEvent e)
+			{
+				if (fullScreen)
+					return true;
+				if (e.getActionMasked() == MotionEvent.ACTION_DOWN)
+				{
+					downX = e.getRawX();
+					startWidth = width;
+				}
+				else if (e.getActionMasked() == MotionEvent.ACTION_MOVE)
+				{
+					width = Math.max(px(200), Math.min(parent.getWidth(), startWidth + (int)(e.getRawX() - downX)));
+					layout();
+				}
+				return true;
+			}
+		});
+		bottom.addView(corner, new LinearLayout.LayoutParams(px(40), px(40)));
+		window.addView(bottom, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, px(40)));
+
+		parent.addView(window, new FrameLayout.LayoutParams(width, ViewGroup.LayoutParams.WRAP_CONTENT));
+		layout();
+		// Bottom right at first
+		moveTo(parent.getWidth() - width - px(16), parent.getHeight() - windowHeight() - px(16));
+		handler.post(progress);
+	}
+
+	private int windowHeight()
+	{
+		return width * videoHeight / videoWidth + px(80);
+	}
+
+	// The size follows the width and the shape of the video
+	private void layout()
+	{
+		if (window == null)
+			return;
+		FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) window.getLayoutParams();
+		if (fullScreen)
+		{
+			lp.width = parent.getWidth();
+			lp.height = parent.getHeight();
+		}
+		else
+		{
+			lp.width = width;
+			lp.height = Math.min(parent.getHeight(), windowHeight());
+		}
+		window.setLayoutParams(lp);
+		if (!fullScreen)
+			moveTo(left(), top());
+	}
+
+	// By the margins, not by setX(): the app draws on a SurfaceView, which leaves room for the
+	// views over it only as it lays them out, and a window moved without a layout was drawn over
+	// by the app at the places it moved to until it stopped
+	private void moveTo(float x, float y)
+	{
+		FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) window.getLayoutParams();
+		lp.leftMargin = (int) Math.max(0, Math.min(parent.getWidth() - width, x));
+		lp.topMargin = (int) Math.max(0, Math.min(parent.getHeight() - Math.min(parent.getHeight(), windowHeight()), y));
+		window.setLayoutParams(lp);
+	}
+
+	private float left()
+	{
+		return ((FrameLayout.LayoutParams) window.getLayoutParams()).leftMargin;
+	}
+
+	private float top()
+	{
+		return ((FrameLayout.LayoutParams) window.getLayoutParams()).topMargin;
+	}
+
+	private void toggleFullScreen()
+	{
+		fullScreen = !fullScreen;
+		if (fullScreen)
+		{
+			savedX = left();
+			savedY = top();
+			savedWidth = width;
+			FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) window.getLayoutParams();
+			lp.leftMargin = 0;
+			lp.topMargin = 0;
+			window.setLayoutParams(lp);
+		}
+		else
+		{
+			width = savedWidth;
+		}
+		layout();
+		if (!fullScreen)
+			moveTo(savedX, savedY);
+	}
+
+	private void open()
+	{
+		releasePlayer();
+		try
+		{
+			player = new MediaPlayer();
+			player.setSurface(surface);
+			player.setDataSource(path);
+			player.setOnPreparedListener(new MediaPlayer.OnPreparedListener()
+			{
+				public void onPrepared(MediaPlayer mp)
+				{
+					prepared = true;
+					seek.setMax(mp.getDuration());
+					mp.start();
+					updateButtons();
+				}
+			});
+			player.setOnVideoSizeChangedListener(new MediaPlayer.OnVideoSizeChangedListener()
+			{
+				public void onVideoSizeChanged(MediaPlayer mp, int w, int h)
+				{
+					if (w > 0 && h > 0)
+					{
+						videoWidth = w;
+						videoHeight = h;
+						layout();
+					}
+				}
+			});
+			player.setOnCompletionListener(new MediaPlayer.OnCompletionListener()
+			{
+				public void onCompletion(MediaPlayer mp)
+				{
+					updateButtons();
+				}
+			});
+			player.setOnErrorListener(new MediaPlayer.OnErrorListener()
+			{
+				public boolean onError(MediaPlayer mp, int what, int extra)
+				{
+					if (mp != player)
+						return true;
+					Log.i("SDL", "VideoWindow: cannot play " + path + ": " + what + "/" + extra);
+					Toast.makeText(context, "Cannot play " + new File(path).getName(), Toast.LENGTH_LONG).show();
+					close();
+					return true;
+				}
+			});
+			player.prepareAsync();
+		}
+		catch (Exception e)
+		{
+			Log.i("SDL", "VideoWindow: cannot open " + path + ": " + e);
+			Toast.makeText(context, "Cannot open " + new File(path).getName(), Toast.LENGTH_LONG).show();
+			close();
+		}
+	}
+
+	// To the very place: by default the player goes to the key frame before it, which can be the
+	// start of a short video
+	private void seekTo(int ms)
+	{
+		if (player == null || !prepared)
+			return;
+		try
+		{
+			if (android.os.Build.VERSION.SDK_INT >= 26)
+				player.seekTo((long) ms, MediaPlayer.SEEK_CLOSEST);
+			else
+				player.seekTo(ms);
+		}
+		catch (Exception e)
+		{
+		}
+	}
+
+	private void releasePlayer()
+	{
+		prepared = false;
+		if (player != null)
+		{
+			try
+			{
+				player.release();
+			}
+			catch (Exception e)
+			{
+			}
+		}
+		player = null;
+	}
+
+	private void togglePlay()
+	{
+		if (player == null || !prepared)
+			return;
+		try
+		{
+			if (player.isPlaying())
+				player.pause();
+			else
+				player.start();
+		}
+		catch (Exception e)
+		{
+		}
+		updateButtons();
+	}
+
+	private void updateButtons()
+	{
+		boolean playing = false;
+		try
+		{
+			playing = player != null && prepared && player.isPlaying();
+		}
+		catch (Exception e)
+		{
+		}
+		playButton.setText(playing ? "⏸" : "▶");
+	}
+
+	private static String clock(int ms)
+	{
+		int s = ms / 1000;
+		return (s / 60) + ":" + (s % 60 < 10 ? "0" : "") + (s % 60);
+	}
+
+	private final Runnable progress = new Runnable()
+	{
+		public void run()
+		{
+			if (window == null)
+				return;
+			try
+			{
+				if (player != null && prepared && !seeking && player.getDuration() > 0)
+				{
+					seek.setProgress(player.getCurrentPosition());
+					time.setText(clock(player.getCurrentPosition()) + " / " + clock(player.getDuration()));
+				}
+			}
+			catch (Exception e)
+			{
+			}
+			handler.postDelayed(this, 500);
+		}
+	};
+}
