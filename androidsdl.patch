+	// The 4:3 flag lives in native code but is re-read by every SDL_SetVideoMode(),
+	// so an app can change it at runtime - it just has to go through here, or the
+	// next onSurfaceChanged() would put Globals.KeepAspectRatio back.
+	public void setKeepAspectRatio(int keepRatio)
+	{
+		Globals.KeepAspectRatio = (keepRatio != 0);
+		if( mWidth > 0 && mHeight > 0 )
+			nativeResize(mWidth, mHeight, keepRatio);
+	}
