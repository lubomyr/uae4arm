+			DemoRenderer renderer = ( MainActivity.instance != null && MainActivity.instance.mGLView != null ) ?
+										MainActivity.instance.mGLView.mRenderer : null;
+			if( renderer != null &&
+				( ( Globals.SwVideoMode && Globals.MultiThreadedVideo ) || Globals.CompatibilityHacksVideo ) )
+				renderer.reloadScreenKbGraphics = true;
+			else
